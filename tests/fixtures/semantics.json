{
  "_comment": "独立语义测试语料（温和版，与运行配置分离）：验证宿主适配层能区分六类关键语义。生产日志只记录类别与规则命中，不保存语料本体。",
  "cases": [
    {"text": "做得不错，今晚奖励我一下吧", "expect": "praise_request"},
    {"text": "夸我，我今天很乖", "expect": "praise_request"},
    {"text": "罚我吧，我就是故意的", "expect": "eager_penalty"},
    {"text": "我想要被罚，狠狠罚", "expect": "eager_penalty"},
    {"text": "红色安全词", "expect": "hard_stop"},
    {"text": "安全词！立刻停下来", "expect": "hard_stop"},
    {"text": "够了，我受不了了", "expect": "ambiguous_refusal"},
    {"text": "我不要了，真的不行了", "expect": "ambiguous_refusal"},
    {"text": "哼，才不要听你的", "expect": "brat_defiance"},
    {"text": "偏不，就不", "expect": "brat_defiance"},
    {"text": "退出角色吧，抱抱我", "expect": "aftercare"},
    {"text": "戏份到这里吧，收个尾，抱抱我", "expect": "aftercare"},
    {"text": "别停，继续", "expect": "none"},
    {"text": "今晚想吃火锅", "expect": "none"}
  ]
}
